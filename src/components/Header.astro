---
import { getSession } from "auth-astro/server";
const session = await getSession(Astro.request);
import { Input } from "./Input";
import { TooltipLogout } from "./Tooltip";
---

<header
  class="fixed top-0 left-0 z-50 w-full flex flex-wrap sm:flex-nowrap justify-between items-center bg-primary/95 backdrop-blur-md border-b border-white/5 px-4 md:px-6 py-3 gap-2"
>
  <!-- Logo -->
  <a href="/" class="flex items-center gap-x-2 shrink-0 group">
    <div class="bg-rose rounded-lg size-7 flex items-center justify-center shadow-lg shadow-rose/30 group-hover:shadow-rose/50 transition-shadow">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
        <path d="M2 4a2 2 0 0 1 2-2h12l6 6v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4z"/>
        <path d="M14 2v6h6" fill="none" stroke="white" stroke-width="2"/>
        <rect x="6" y="12" width="3" height="6" rx="1" fill="currentColor"/>
        <rect x="11" y="9" width="3" height="9" rx="1" fill="currentColor"/>
        <rect x="16" y="11" width="3" height="7" rx="1" fill="currentColor"/>
      </svg>
    </div>
    <span class="text-white font-bold text-lg tracking-tight">Suitch</span>
  </a>

  <!-- Búsqueda desktop/tablet -->
  <div class="hidden sm:block flex-1 max-w-xl mx-4">
    <Input client:visible />
  </div>

  <!-- Acciones de sesión -->
  <div class="flex gap-x-2 items-center shrink-0">
    {
      session ? (
        <div class="flex items-center gap-x-2">
          <div class="flex items-center gap-x-2 bg-white/5 rounded-full pl-1 pr-3 py-1">
            <img
              src={session.user?.image}
              alt={session.user?.name}
              class="w-7 h-7 rounded-full ring-2 ring-rose/50"
            />
            <span class="text-sm font-medium text-white/80 hidden md:block">{session.user?.name}</span>
          </div>
          <form action="/api/auth/signout" method="post">
            <button
              id="logout"
              type="submit"
              class="relative flex items-center justify-center bg-white/8 hover:bg-rose/20 border border-white/10 hover:border-rose/40 rounded-lg p-2 text-white/70 hover:text-rose transition-all duration-200 group"
              aria-label="Cerrar sesión"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M14 8v-2a2 2 0 0 0 -2 -2h-7a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h7a2 2 0 0 0 2 -2v-2" />
                <path d="M9 12h12l-3 -3" />
                <path d="M18 15l3 -3" />
              </svg>
              <TooltipLogout />
            </button>
          </form>
        </div>
      ) : (
        <form action="/api/auth/signin" method="post">
          <input type="hidden" name="provider" value="twitch" />
          <button
            id="login"
            type="submit"
            class="flex items-center gap-x-2 rounded-lg px-4 py-2 text-sm font-semibold text-white bg-rose hover:bg-rose/80 shadow-lg shadow-rose/20 hover:shadow-rose/40 transition-all duration-200"
          >
            <!-- Icono Twitch -->
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714z"/>
            </svg>
            <span class="hidden sm:inline">Conectar con Twitch</span>
            <span class="sm:hidden">Login</span>
          </button>
        </form>
      )
    }
  </div>

  <!-- Búsqueda móvil -->
  <div class="sm:hidden w-full">
    <Input client:visible />
  </div>
</header>

<script>
  const { signIn, signOut } = await import("auth-astro/client");
  const loginButton = document.getElementById("login");
  const logoutButton = document.getElementById("logout");
  if (loginButton) {
    loginButton.addEventListener("click", async (e) => {
      e.preventDefault();
      await signIn("twitch");
    });
  }
  if (logoutButton) {
    logoutButton.addEventListener("click", async (e) => {
      e.preventDefault();
      await signOut();
    });
  }
</script>
