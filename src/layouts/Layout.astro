---
import Header from "../components/Header.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Suitch — descubre streams en vivo y canales de Twitch" />
    <title>Suitch</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header />
    <slot />
  </body>
</html>

<style>
  :root {
    --color-primary: #161616;
    --color-secondary: #ec4899;
    --color-tertiary: #1c1c1c;
  }

  html {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    color: white;
    background: var(--color-primary);
    /* Móvil: header ocupa dos líneas (logo+input) */
    padding-top: 116px;
  }

  @media (min-width: 640px) {
    html {
      /* Tablet y desktop: header en una sola línea */
      padding-top: 72px;
    }
  }
</style>
